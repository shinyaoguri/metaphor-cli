.build/
.swiftpm/
DerivedData/
*.xcodeproj
*.xcworkspace
.DS_Store

# direnv local cache
.direnv/

# metaphor runtime/IPC scratch (probe frames, session manifest, build status)
# written when running watch/mcp/probe inside the repo
.metaphor/

# 実スケッチのスモーク (scripts/smoke-sketch.py) が残す子プロセスのログ
# CI は artifact として拾うが、手元では消えて構わない
.smoke-logs/

# Python bytecode cache (scripts/measure-roundtrip.py 等の実行で生成)
__pycache__/
*.pyc

# 秘密情報の置き場（コミットしない）
.env
.env.*
!.env.example

# Claude Code のマシンローカル成果物（settings.json だけは共有するため追跡する）
.claude/worktrees/
.claude/settings.local.json
